---
import { NavigationLinks, SITE } from '@/config'
---

<header class="pt-6 pb-12">
    <nav class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between" aria-label="Global">
        <a
            class="group flex items-center gap-3 text-neutral-900 outline-none ring-neutral-300 focus-visible:ring"
            href="/"
            aria-label="Brand"
        >
            <div class="leading-tight">
                <span class="font-display text-xl tracking-tight">{SITE.title}</span>
            </div>
        </a>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs uppercase tracking-[0.35em] text-neutral-500">
            {NavigationLinks.map(link => (
                <a
                    href={link.url}
                    class="transition hover:text-neutral-900"
                    data-astro-prefetch
                >
                    {link.name}
                </a>
            ))}
        </div>
    </nav>
</header>
