---
import { FooterLinks, SITE } from '@/config'
---

<footer class="mt-16 border-t border-neutral-200/70">
    <div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2">
            {FooterLinks.map(section => (
                <div>
                    <h3 class="text-xs uppercase tracking-[0.3em] text-neutral-500">
                        {section.section}
                    </h3>
                    <ul class="mt-4 space-y-3 text-sm text-neutral-600">
                        {section.links.map(link => (
                            <li>
                                <a
                                    href={link.url}
                                    class="transition hover:text-neutral-900"
                                >
                                    {link.name}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-between gap-3 text-xs uppercase tracking-[0.3em] text-neutral-500">
            <p>
                © <span id="current-year"></span> {SITE.title}
            </p>
            <p>All rights reserved</p>
        </div>
    </div>
</footer>
<script is:inline>
    document.getElementById('current-year').textContent = new Date().getFullYear();
</script>
