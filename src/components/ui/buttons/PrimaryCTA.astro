---
import Icon from '@components/ui/icons/icon.astro'

const { title, url, noArrow } = Astro.props

interface Props {
  title?: string
  url?: string
  noArrow?: boolean
}

const baseClasses = 'group inline-flex items-center justify-center gap-x-2 rounded-full border border-neutral-300 px-5 py-2 text-xs uppercase tracking-[0.35em] text-neutral-700 transition focus-visible:ring outline-none'
const borderClasses = 'hover:border-neutral-500'
const bgColorClasses = 'hover:text-neutral-900'
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50'
const fontSizeClasses = ''
const ringClasses = 'ring-neutral-300';
---

<a
    class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses}`}
    href={url}
    data-astro-prefetch
>
  {title}
  {noArrow ? null : <Icon name="arrowRight" />}
</a>
