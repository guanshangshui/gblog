---
import BaseLayout from '@layouts/BaseLayout.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const friendsData: CollectionEntry<'friends'>[] = await getCollection('friends')
const friends = friendsData[0]?.data ?? []
---

<BaseLayout title="Friends" description="">
    <MainSection title="Friends" subTitle="" />

    <section class="mx-auto max-w-5xl px-4 pt-8 sm:px-6 lg:px-8 mb-10">
        <div class="grid gap-6 grid-cols-1 sm:grid-cols-2">
            {
                friends.map(f => (
                    <div class="rounded-2xl border border-neutral-200 bg-white p-5">
                        <div class="flex items-center gap-4">
                            <img
                                data-light={f.avatar}
                                data-dark={f.avatarDark}
                                class="friend-avatar rounded-full size-14"
                                src={f.avatar}
                                alt={f.title}
                            />

                            <div>
                                <h3 class="font-medium text-neutral-900">
                                    {f.name}
                                </h3>
                                <p class="text-xs uppercase tracking-[0.25em] text-neutral-500">
                                    {f.title}
                                </p>
                            </div>
                        </div>

                        <p class="mt-3 text-sm text-neutral-600">
                            {f.description}
                        </p>

                        <div class="mt-4 flex flex-wrap gap-2 text-xs uppercase tracking-[0.25em] text-neutral-500">
                            {
                                f.social?.blog && (
                                    <a
                                        href={f.social.blog}
                                        class="rounded-full border border-neutral-200 px-3 py-1 transition hover:border-neutral-500 hover:text-neutral-900"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Website
                                    </a>
                                )
                            }
                            {
                                f.social?.twitter && (
                                    <a
                                        href={`https://twitter.com/${f.social.twitter}`}
                                        class="rounded-full border border-neutral-200 px-3 py-1 transition hover:border-neutral-500 hover:text-neutral-900"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Twitter
                                    </a>
                                )
                            }
                            {
                                f.social?.github && (
                                    <a
                                        href={`https://github.com/${f.social.github}`}
                                        class="rounded-full border border-neutral-200 px-3 py-1 transition hover:border-neutral-500 hover:text-neutral-900"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        GitHub
                                    </a>
                                )
                            }
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <script is:inline>
    function changeAvatar(event) {
        const dark = event?.detail === 'dark'
        Array.from(document.getElementsByClassName('friend-avatar')).forEach((avatar) => {
            const darkAvatar = avatar.getAttribute('data-dark')
            if (dark && darkAvatar) {
                avatar.src = avatar.getAttribute('data-dark')
            }
            else {
                avatar.src = avatar.getAttribute('data-light')
            }
        })
    }
    function getCurrentTheme() {
        if (window.localStorage.getItem('hs_theme')) {
            return window.localStorage.getItem('hs_theme') ?? 'default'
        }

        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default'
    }
    document.addEventListener('DOMContentLoaded', () => {
        changeAvatar({ detail: getCurrentTheme() })

        window.addEventListener('on-hs-appearance-change', changeAvatar)
    })
    </script>
</BaseLayout>
