---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import { formatDate } from '@support/time'
import { SITE } from '@/config'

const allPosts: CollectionEntry<'posts'>[] = (await getCollection('posts')).sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
const recentPosts = allPosts.slice(0, 6)

const tagCounts = new Map<string, number>()
allPosts.forEach((post) => {
    const tags = post.data.tags ?? [post.data.category]
    tags.forEach((rawTag) => {
        const tag = rawTag.trim()
        if (!tag) {
            return
        }
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)
    })
})

const tags = [...tagCounts.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 12)
    .map(([tag, count]) => ({
        tag,
        count,
        slug: encodeURIComponent(tag),
    }))
---

<BaseLayout>
    <section class="relative">
        <div class="max-w-3xl">
            {SITE.title && (
                <h1 class="font-display text-4xl tracking-tight text-neutral-900 sm:text-5xl">
                    {SITE.title}
                </h1>
            )}
            {SITE.description && (
                <p class="mt-4 text-pretty text-lg text-neutral-600">
                    {SITE.description}
                </p>
            )}
        </div>
    </section>

    {
        recentPosts.length > 0 && (
            <section class="mt-12">
                <div class="divide-y divide-neutral-200/80 border-t border-neutral-200/80">
                    {recentPosts.map(post => (
                        <article class="group py-6">
                            <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:justify-between">
                                <div class="max-w-3xl">
                                    <a
                                        class="font-display text-xl text-neutral-900 transition group-hover:text-neutral-600"
                                        href={`/posts/${post.slug}/`}
                                        data-astro-prefetch
                                    >
                                        {post.data.title}
                                    </a>
                                    <p class="mt-2 text-sm text-neutral-600">
                                        {post.data.description}
                                    </p>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        {(post.data.tags ?? [post.data.category]).map(tag => (
                                            <a
                                                class="rounded-full border border-neutral-200 px-3 py-1 text-[11px] uppercase tracking-[0.25em] text-neutral-500 transition hover:border-neutral-400 hover:text-neutral-900"
                                                href={`/tags/${encodeURIComponent(tag)}/`}
                                                data-astro-prefetch
                                            >
                                                {tag}
                                            </a>
                                        ))}
                                    </div>
                                </div>
                                <time class="text-xs uppercase tracking-[0.35em] text-neutral-500">
                                    {formatDate(post.data.pubDate)}
                                </time>
                            </div>
                        </article>
                    ))}
                </div>
            </section>
        )
    }

    {
        tags.length > 0 && (
            <section class="mt-12">
                <div class="flex flex-wrap gap-3">
                    {tags.map(({ tag, count, slug }) => (
                        <a
                            class="group flex items-center gap-2 rounded-full border border-neutral-200 px-4 py-2 text-sm text-neutral-700 transition hover:border-neutral-500 hover:text-neutral-900"
                            href={`/tags/${slug}/`}
                            data-astro-prefetch
                        >
                            <span class="font-display">{tag}</span>
                            <span class="text-xs uppercase tracking-[0.25em] text-neutral-500">{count}</span>
                        </a>
                    ))}
                </div>
            </section>
        )
    }
</BaseLayout>
