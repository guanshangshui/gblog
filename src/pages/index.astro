---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import { formatDate } from '@support/time'
import { SITE } from '@/config'
import avatarSrc from '@images/brand_logo.jpeg'

const allPosts: CollectionEntry<'posts'>[] = (await getCollection('posts')).sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const introText = SITE.shortDescription || SITE.description
const displayTitle = SITE.title || SITE.author

const timelineMap = new Map<number, { label: string; posts: CollectionEntry<'posts'>[] }>()
allPosts.forEach((post) => {
    const year = post.data.pubDate.getFullYear()
    const month = String(post.data.pubDate.getMonth() + 1).padStart(2, '0')
    const key = year * 100 + Number(month)
    const label = `${year}-${month}`
    const entry = timelineMap.get(key) ?? { label, posts: [] }
    entry.posts.push(post)
    timelineMap.set(key, entry)
})

const timeline = [...timelineMap.entries()]
    .sort((a, b) => b[0] - a[0])
    .map(([, value]) => value)
---

<BaseLayout>
    <section class="relative">
        <div class="flex max-w-3xl flex-col gap-4">
            <div class="flex items-center gap-4">
                <img
                    class="h-16 w-16 rounded-full border border-neutral-200 object-cover"
                    src={avatarSrc.src}
                    alt={displayTitle || 'Avatar'}
                    loading="eager"
                />
                <div class="leading-tight">
                    {displayTitle && (
                        <h1 class="font-display text-3xl tracking-tight text-neutral-900 sm:text-4xl">
                            {displayTitle}
                        </h1>
                    )}
                    {introText && (
                        <p class="mt-2 text-pretty text-sm text-neutral-600 sm:text-base">
                            {introText}
                        </p>
                    )}
                </div>
            </div>
        </div>
    </section>

    {
        timeline.length > 0 && (
            <section class="mt-10 space-y-10">
                {timeline.map(({ label, posts }) => (
                    <div>
                        <h2 class="text-xs uppercase tracking-[0.35em] text-neutral-500">
                            {label}
                        </h2>
                        <div class="mt-4 divide-y divide-neutral-200/80 border-t border-neutral-200/80">
                            {posts.map(post => (
                                <article class="group py-5">
                                    <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
                                        <div class="max-w-3xl">
                                            <a
                                                class="font-display text-lg text-neutral-900 transition group-hover:text-neutral-600"
                                                href={`/posts/${post.slug}/`}
                                                data-astro-prefetch
                                            >
                                                {post.data.title}
                                            </a>
                                            {post.data.description && (
                                                <p class="mt-2 text-sm text-neutral-600">
                                                    {post.data.description}
                                                </p>
                                            )}
                                        </div>
                                        <time class="text-xs uppercase tracking-[0.35em] text-neutral-500">
                                            {formatDate(post.data.pubDate)}
                                        </time>
                                    </div>
                                </article>
                            ))}
                        </div>
                    </div>
                ))}
            </section>
        )
    }
</BaseLayout>
